    {
      "id": "7abb5825-d49d-4e0f-9aea-8f02e3481258",
      "name": "Flatten events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || {};\nconst out = [];\nfor (const entry of (body.entry || [])) {\n  const evs = entry.messaging || entry.changes || [entry];\n  for (const ev of evs) {\n    const msg = ev.message || (ev.value && ev.value.message) || {};\n    const atts = (msg.attachments || []).map(a => a.type);\n    const summary = 'text=' + (msg.text ? 'yes' : 'no') + ' attachments=[' + atts.join(',') + ']' + (msg.is_echo ? ' echo' : '') + (msg.is_unsupported ? ' unsupported' : '');\n    out.push({ json: { ts: new Date().toISOString(), summary, raw: JSON.stringify(ev).slice(0, 8000) } });\n  }\n}\nif (!out.length) out.push({ json: { ts: new Date().toISOString(), summary: 'no entries', raw: JSON.stringify(body).slice(0, 8000) } });\nreturn out;"
      }
    },
