    {
      "id": "61ac9f91-7a6a-4c3f-a0e8-a54efecc1196",
      "name": "Build one row per model",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const root = $json.shop || $json;\nlet items = (root.items && root.items.item) || [];\nif (!Array.isArray(items)) items = [items];\n\nconst first = (v) => Array.isArray(v) ? v[0] : v;\nconst txt = (v) => { v = first(v); if (v && typeof v === 'object') v = v._ ?? v['#text'] ?? ''; return String(v ?? '').trim(); };\nconst paramsOf = (it) => { let p = it.param; if (!p) return []; return Array.isArray(p) ? p : [p]; };\nconst sizeOf = (it) => {\n  const p = paramsOf(it);\n  const hit = p.find(x => x && typeof x === 'object' && String(x.name).toLowerCase().startsWith('розм')) || p[0];\n  if (hit && typeof hit === 'object') return String(hit._ ?? hit['#text'] ?? '').trim();\n  return String(hit || '').trim();\n};\n\nconst groups = new Map();\nfor (const it of items) {\n  const name = txt(it.name);\n  const gid = String(first(it.group_id) || name);\n  if (!groups.has(gid)) groups.set(gid, { model: name, group_id: gid, price: Number(first(it.priceuah)) || 0, inStock: [], out: [], codes: [], images: [], params: new Map(), description: '' });\n  const g = groups.get(gid);\n  const size = sizeOf(it);\n  const vals = [].concat(it.available);\n  const available = vals.some(v => String(v) === 'true');\n  const qty = Number(first(it.quantity_in_stock) || 0);\n  const code = txt(it.vendorCode);\n  if (code) g.codes.push(size + ': ' + code);\n  if (available && qty > 0) g.inStock.push(size + ' (' + qty + ')');\n  else g.out.push(size);\n  for (const im of [].concat(it.image || [])) { const u = String(im || '').trim(); if (u && !g.images.includes(u)) g.images.push(u); }\n  for (const p of paramsOf(it)) { if (p && typeof p === 'object') { const n = String(p.name || '').trim(); if (n && !n.toLowerCase().startsWith('розм') && !g.params.has(n)) g.params.set(n, String(p._ ?? p['#text'] ?? '').trim()); } }\n  if (!g.description) g.description = txt(it.description).replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 700);\n}\n\nreturn Array.from(groups.values()).map(g => ({ json: {\n  model: g.model,\n  group_id: g.group_id,\n  price: g.price,\n  sizes_in_stock: g.inStock.join(', '),\n  sizes_out: g.out.join(', '),\n  in_stock_count: g.inStock.length,\n  codes: g.codes.join(', '),\n  image: g.images[0] || '',\n  images: g.images.slice(0, 8).join(' '),\n  params: Array.from(g.params.entries()).map(([k, v]) => k + ': ' + v).join('; ').slice(0, 500),\n  description: g.description\n} }));"
      }
    },
