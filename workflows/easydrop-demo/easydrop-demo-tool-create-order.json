    {
      "id": "961ddd57-7243-4f25-9181-eca372a99495",
      "name": "Check size in stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const inp = $('Order request').first().json;\nconst row = $input.first().json || {};\nconst size = String(inp.size).replace(/\\D/g, '');\nconst parts = String(row.sizes_in_stock || '').split(',').map(s => s.trim());\nconst hit = parts.find(s => s.startsWith(size + ' ('));\nconst m = hit ? hit.match(/\\((\\d+)\\)/) : null;\nconst qty = m ? Number(m[1]) : 0;\nconst codeHit = String(row.codes || '').split(',').map(s => s.trim()).find(s => s.startsWith(size + ': '));\nconst code = codeHit ? codeHit.slice(size.length + 2) : '';\nconst order_id = 'EDR-' + new Date().toISOString().replace(/\\D/g, '').slice(2, 14);\nreturn [{ json: { ok: qty > 0, qty, code, order_id, size: Number(size), model: row.model || '', price: Number(row.price) || 0, destination: inp.city + ', відділення НП ' + inp.np_branch, now: new Date().toISOString() } }];"
      }
    },
