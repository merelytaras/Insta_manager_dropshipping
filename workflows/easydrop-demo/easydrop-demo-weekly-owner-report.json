    {
      "id": "a1273e3f-bebf-4859-ab0e-08144cf41bbf",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const since = Date.now() - 7 * 86400000;\nconst log = $('Get chat log').all().map(i => i.json).filter(r => r.ts && new Date(r.ts).getTime() >= since);\nconst ord = $('Get orders').all().map(i => i.json).filter(r => r.order_id && r.created_at && new Date(r.created_at).getTime() >= since);\nconst customers = new Set(log.filter(r => r.kind !== 'nudge').map(r => r.ig_user_id)).size;\nconst replies = log.filter(r => r.kind !== 'nudge').length;\nconst nudges = log.filter(r => r.kind === 'nudge').length;\nconst photos = log.filter(r => r.had_photo === 'yes').length;\nconst handoffs = log.filter(r => String(r.bot_reply || '').includes('передано менеджеру')).length;\nconst fallbacks = log.filter(r => r.kind === 'fallback').length;\nconst sum = ord.reduce((s, r) => s + (Number(r.price_uah) || 0), 0);\nconst byStatus = {};\nfor (const o of ord) { const s = o.status || 'невідомо'; byStatus[s] = (byStatus[s] || 0) + 1; }\nconst statusTxt = Object.keys(byStatus).length ? ' (' + Object.entries(byStatus).map(([k, v]) => k + ': ' + v).join(', ') + ')' : '';\nconst conv = customers ? Math.round(ord.length / customers * 100) : 0;\nconst text = '📊 Тижневий звіт бота (останні 7 днів)\\n\\n' +\n  'Клієнтів написало: ' + customers + '\\n' +\n  'Відповідей бота: ' + replies + '\\n' +\n  'Пошуків за фото: ' + photos + '\\n' +\n  'Передано менеджеру: ' + handoffs + '\\n' +\n  'Не змогли прочитати (допис/голосове/стікер): ' + fallbacks + '\\n' +\n  'Нагадувань тим, хто замовк: ' + nudges + '\\n' +\n  'Замовлень: ' + ord.length + statusTxt + (ord.length ? ' на суму ' + sum + ' грн' : '') + '\\n' +\n  'Із розмов у замовлення: ' + conv + '%';\nreturn [{ json: { text } }];"
      }
    },
