      "id": "dddd856a-9fb9-4616-90b5-ba8417c80a8e",
      "name": "Collect unanswered messages",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "u1",
              "name": "customer_id",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const c = $json.messages.data.find(m => m.from.id !== shop); return c ? c.from.id : ''; })() }}"
            },
            {
              "id": "u2",
              "name": "username",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const c = $json.messages.data.find(m => m.from.id !== shop); return c ? c.from.username : ''; })() }}"
            },
            {
              "id": "u3",
              "name": "pending_text",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); const isReal = m => !!m.message || !!m.attachments?.data?.[0]?.image_data; const label = m => m.message ? m.message : (m.attachments?.data?.[0]?.image_data ? '[Клієнт надіслав фото]' : '[unreadable_share]'); const keep = un.filter((m, i) => { if (isReal(m)) return true; const older = un[i + 1]; const card = older && older.message && (new Date(m.created_time) - new Date(older.created_time)) <= 3000; return !card; }); return keep.map(label).filter(Boolean).reverse().join('\\n'); })() }}"
            },
            {
              "id": "u4",
              "name": "last_text_time",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); return un.length ? un[0].created_time : ''; })() }}"
            },
            {
              "id": "u5",
              "name": "context",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const prior = (idx === -1 ? [] : msgs.slice(idx)).filter(m => m.message || m.attachments?.data?.length).slice(0, 6).reverse(); return prior.map(m => (m.from.id === shop ? 'Магазин: ' : 'Клієнт: ') + (m.message || '[зображення]')).join('\\n'); })() }}"
            },
            {
              "id": "u6",
              "name": "image_url",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); const m = un.find(x => x.attachments?.data?.[0]?.image_data?.url); return m ? m.attachments.data[0].image_data.url : ''; })() }}"
            }
          ]
        },
        "options": {}
      }
    },
