    {
      "id": "cd74d3e5-f3ec-45b9-a8e3-e2300f7965eb",
      "name": "Skip already handled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1210,
        300
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.handled = sd.handled || {};\nconst now = Date.now();\nfor (const k of Object.keys(sd.handled)) { if (now - sd.handled[k].at > 3600000) delete sd.handled[k]; }\nconst out = [];\nfor (const it of $input.all()) {\n  const k = it.json.customer_id;\n  const t = it.json.last_text_time;\n  if (sd.handled[k] && sd.handled[k].t === t) continue;\n  sd.handled[k] = { t, at: now };\n  out.push(it);\n}\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    }
