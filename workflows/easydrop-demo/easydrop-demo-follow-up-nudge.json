    {
      "id": "e08ce52f-4f4b-4e90-a379-8ea92b886b1f",
      "name": "Pick customers to nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const MIN_H = 3, MAX_H = 20, H = 3600000, MAX_PER_RUN = 5;\nconst DEFAULT_TEXT = 'Вітаю! Ви цікавилися взуттям — підкажіть, чи ще актуально? Якщо потрібна допомога з моделлю чи розміром, напишіть, і я підберу.';\nconst pickText = (reply) => {\n  const s = String(reply || '');\n  if (/підсумок замовлення|підтверджуєте/i.test(s)) {\n    const lines = s.split('\\n').map(x => x.trim()).filter(Boolean);\n    const i = lines.findIndex(x => /підсумок замовлення/i.test(x));\n    const cand = i >= 0 ? (lines[i + 1] || '') : '';\n    const item = /грн/i.test(cand) ? cand : '';\n    return 'Вітаю! ' + (item ? 'Ваше замовлення (' + item + ') ще чекає підтвердження.' : 'Ваше замовлення ще чекає підтвердження.') + ' Підтверджуєте? Якщо потрібно щось змінити (розмір чи адресу), напишіть.';\n  }\n  if (/який розмір|вкажіть розмір|розмір вам потрібен|потрібен розмір|підкажіть розмір/i.test(s)) {\n    const m = s.match(/обрали\\s+(.+?)\\s+[—-]/i);\n    return 'Вітаю! ' + (m ? 'Ви обрали ' + m[1] + '. ' : '') + 'Підкажіть, будь ласка, який розмір вам потрібен, і я перевірю наявність.';\n  }\n  return DEFAULT_TEXT;\n};\nconst now = Date.now();\nconst hourKyiv = Number(new Date().toLocaleString('en-GB', { timeZone: 'Europe/Kyiv', hour: 'numeric', hour12: false }));\nif (hourKyiv < 10 || hourKyiv >= 21) return [];\nconst log = $('Get chat log').all().map(i => i.json).filter(r => r.ts && r.ig_user_id);\nconst last = new Map();\nfor (const r of log) { const p = last.get(r.ig_user_id); if (!p || new Date(r.ts) > new Date(p.ts)) last.set(r.ig_user_id, r); }\nconst orders = $('Get orders').all().map(i => i.json).filter(r => r.ig_user_id && r.created_at);\nconst paused = new Map($('Get handoffs').all().map(i => i.json).filter(r => r.ig_user_id).map(r => [String(r.ig_user_id), r.paused_until]));\nconst out = [];\nfor (const [id, r] of last) {\n  if (out.length >= MAX_PER_RUN) break;\n  if (r.kind !== 'agent') continue;\n  const age = (now - new Date(r.ts).getTime()) / H;\n  if (age < MIN_H || age > MAX_H) continue;\n  if (!String(r.bot_reply || '').includes('?')) continue;\n  if (orders.some(o => String(o.ig_user_id) === String(id) && now - new Date(o.created_at).getTime() < 24 * H)) continue;\n  const p = paused.get(String(id));\n  if (p && new Date(p).getTime() > now) continue;\n  out.push({ json: { customer_id: id, username: r.username || '', text: pickText(r.bot_reply) } });\n}\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "8fbd2c36-2a7b-48ee-a222-dcf651d56f2e",
