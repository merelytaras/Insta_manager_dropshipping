        "url": "={{ 'https://graph.facebook.com/v27.0/' + $('Get IG account').first().json.value + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.ig_user_id }, message: { text: $json.bot_reply } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Instagram Token"
        }
      },
      "onError": "continueRegularOutput"
    },
