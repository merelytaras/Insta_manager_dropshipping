    {
      "id": "3254ff51-24bf-4e9c-bd6b-65225a32dbb4",
      "name": "Fetch missing photos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const indexed = new Set($input.all().map(i => String(i.json.group_id || '')).filter(Boolean));\nconst fresh = (r) => r.model && r.group_id && (Date.now() - new Date(r.updatedAt).getTime() < 3 * 86400000);\nconst todo = $('Get catalog').all().map(i => i.json).filter(r => fresh(r) && !indexed.has(String(r.group_id)) && r.image && !String(r.image).includes('empty_item'));\nfor (let i = todo.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [todo[i], todo[j]] = [todo[j], todo[i]]; }\nconst MAX_BYTES = 8000000, BUDGET = 24000000, CHUNK = 6;\nconst out = [];\nlet tries = 0, total = 0;\nfor (let i = 0; i < todo.length && out.length < 40 && tries < 60 && total < BUDGET; i += CHUNK) {\n  const chunk = todo.slice(i, i + CHUNK);\n  tries += chunk.length;\n  const res = await Promise.all(chunk.map(async (r) => {\n    const url = String(r.image).split(' ')[0];\n    try {\n      const buf = await this.helpers.httpRequest({ url, encoding: 'arraybuffer', json: false, timeout: 20000 });\n      const b = Buffer.from(buf);\n      if (b.length < 2000 || b.length > MAX_BYTES) return null;\n      return { size: b.length, json: { group_id: String(r.group_id), model: r.model, img_url: url, mime: /\\.webp/i.test(url) ? 'image/webp' : 'image/jpeg', b64: b.toString('base64') } };\n    } catch (e) { return null; }\n  }));\n  for (const x of res) { if (x && out.length < 40 && total + x.size <= BUDGET) { out.push({ json: x.json }); total += x.size; } }\n}\nreturn out;"
      }
    },
    {
      "id": "f8fd7cea-2483-40b3-849d-3629f430d41f",
      "name": "Build index rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const src = $('Fetch missing photos').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const v = it.json.embedding && it.json.embedding.values;\n  const s = src[i] && src[i].json;\n  if (v && s) out.push({ json: { group_id: s.group_id, model: s.model, img_url: s.img_url, vec: JSON.stringify(v.map(x => Math.round(x * 10000) / 10000)) } });\n});\nreturn out;"
      }
    },
