    {
      "parameters": {
        "content": "## Instagram polling (fallback)\nMeta does not push real-time DM webhooks to this app yet, so this workflow checks the shop conversations every few minutes.\nA customer is answered when their LAST message is recent (10 min), not empty and not from the shop.\nEach conversation runs in its own sub-run (Shoes - Conversation handler).\nEvery poll costs 1 execution: keep this workflow unpublished while testing, or use a cron such as */5 9-20 * * * for business hours.",
        "height": 272,
        "width": 880,
        "color": 3
      },
      "id": "8ea369a1-9111-4e9b-bed4-d546299095bb",
      "name": "Sticky Note 240aaae8",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "u1",
              "name": "customer_id",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const c = $json.messages.data.find(m => m.from.id !== shop); return c ? c.from.id : ''; })() }}"
            },
            {
              "id": "u2",
              "name": "username",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const c = $json.messages.data.find(m => m.from.id !== shop); return c ? c.from.username : ''; })() }}"
            },
            {
              "id": "u3",
              "name": "pending_text",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); const label = m => m.message ? (m.message + (m.story ? ' [відповідь на сторіс магазину]' : '')) : (m.attachments?.data?.[0]?.image_data ? '[Клієнт надіслав зображення]' : (m.shares?.data?.length ? '[Клієнт поділився публікацією: ' + (m.shares.data[0].description || m.shares.data[0].name || m.shares.data[0].link || '') + ']' : (m.story ? '[Клієнт відповів на сторіс магазину]' : ''))); return un.map(label).filter(Boolean).reverse().join('\\n'); })() }}"
            },
            {
              "id": "u4",
              "name": "last_text_time",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); const has = m => m.message || m.attachments?.data?.[0]?.image_data || m.shares?.data?.length || m.story; const t = un.find(has); return t ? t.created_time : ''; })() }}"
            },
            {
              "id": "u5",
              "name": "context",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const prior = (idx === -1 ? [] : msgs.slice(idx)).filter(m => m.message || m.attachments?.data?.length).slice(0, 6).reverse(); return prior.map(m => (m.from.id === shop ? 'Магазин: ' : 'Клієнт: ') + (m.message || '[зображення]')).join('\\n'); })() }}"
            },
            {
              "id": "u6",
              "name": "image_url",
              "type": "string",
              "value": "={{ (() => { const shop = $('Get IG account').first().json.value; const msgs = $json.messages.data; const idx = msgs.findIndex(m => m.from.id === shop); const un = (idx === -1 ? msgs : msgs.slice(0, idx)).filter(m => Date.now() - new Date(m.created_time).getTime() < 900000); const u = un.map(m => m.attachments?.data?.[0]?.image_data?.url || m.story?.reply_to?.link || m.story?.mention?.link).find(Boolean); return u || ''; })() }}"
            }
          ]
        },
        "options": {}
