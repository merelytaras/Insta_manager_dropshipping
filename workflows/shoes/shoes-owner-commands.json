      "id": "9ba36498-1b02-4082-ae6e-ec3ffa8d3aee",
      "name": "Owner update",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "const OWNER = String($('Get owner chat').first().json.value);\nconst u = $('Owner update').first().json;\nconst msg = u.message;\nconst cb = u.callback_query;\nconst chat = String(msg ? msg.chat.id : (cb && cb.message ? cb.message.chat.id : ''));\nlet cmd = 'ignore';\nlet user = '';\nlet hours = 24;\nlet a1 = '', a2 = '', a3 = '';\nif (chat === OWNER) {\n  if (cb) {\n    if (cb.data === 'bot|on') cmd = 'on';\n    if (cb.data === 'bot|off') cmd = 'off';\n  } else if (msg && msg.text && msg.text.startsWith('/')) {\n    const parts = msg.text.trim().split(/\\s+/);\n    const c = parts[0].toLowerCase().split('@')[0];\n    const map = { '/menu': 'menu', '/start': 'menu', '/help': 'menu', '/stop': 'off', '/off': 'off', '/on': 'on', '/pause': 'pause', '/resume': 'resume', '/paused': 'paused', '/orders': 'orders', '/stock': 'stock', '/ship': 'ship' };\n    cmd = map[c] || 'menu';\n    user = (parts[1] || '').replace('@', '').toLowerCase();\n    hours = Math.min(Math.max(parseInt(parts[2]) || 24, 1), 720);\n    a1 = parts[1] || ''; a2 = parts[2] || ''; a3 = parts[3] || '';\n    if ((cmd === 'pause' || cmd === 'resume') && !user) cmd = 'menu';\n    if (cmd === 'stock') {\n      const s = parseInt(a2); const q = parseInt(a3);\n      if (!a1 || !(s >= 36 && s <= 46) || isNaN(q) || q < 0) { cmd = 'menu'; } else { a2 = String(s); a3 = String(q); }\n    }\n    if (cmd === 'ship' && (!a1 || !a2)) cmd = 'menu';\n  }\n}\nreturn [{ json: { cmd, user, hours, a1, a2, a3, chat_id: OWNER, callback_id: cb ? cb.id : '' } }];"
      },
