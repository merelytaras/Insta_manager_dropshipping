    {
      "parameters": {
        "jsCode": "const row = $('Find model').first().json;\nconst p = $('Parse owner command').first().json;\nconst col = 'size_' + p.a2;\nconst out = { model_id: row.model_id, model_name: row.name, size: p.a2, old_qty: row[col], new_qty: Number(p.a3) };\nfor (let s = 36; s <= 46; s++) {\n  const k = 'size_' + s;\n  const v = row[k];\n  out[k] = k === col ? Number(p.a3) : ((v === null || v === undefined) ? null : Number(v));\n}\nreturn [{ json: out }];"
      },
