        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.order_id);\nconst clean = v => String(v == null ? '' : v).replace(/[<>&]/g, ' ');\nconst day = d => d ? new Date(d).toLocaleDateString('en-CA', { timeZone: 'Europe/Kiev' }) : '';\nconst today = day(new Date());\nconst line = r => '- ' + clean(r.order_id) + ' | ' + clean(r.model_name) + ' р.' + clean(r.size) + ' | ' + clean(r.price_uah) + ' грн | ' + clean(r.buyer_name) + ', ' + clean(r.city) + ' №' + clean(r.np_branch);\nconst pending = rows.filter(r => r.status === 'pending');\nconst confirmed = rows.filter(r => r.status === 'confirmed');\nconst todayCount = rows.filter(r => day(r.created_at) === today).length;\nlet text = 'Orders today: ' + todayCount + '\\n\\nWaiting for your decision (' + pending.length + '):\\n' + (pending.length ? pending.map(line).join('\\n') : '- none');\ntext += '\\n\\nConfirmed, not shipped (' + confirmed.length + '):\\n' + (confirmed.length ? confirmed.map(line).join('\\n') : '- none');\nif (confirmed.length) text += '\\n\\nShip with: /ship ORDER_ID TTN';\nreturn [{ json: { text, chat_id: $('Parse owner command').first().json.chat_id } }];"
      },
