    {
      "parameters": {
        "chatId": "={{ $(\"Parse owner command\").first().json.chat_id }}",
        "text": "bot controls\n\n/stop - stop the bot for everyone\n/on - turn the bot back on\n/pause username 24 - pause one customer for N hours (default 24)\n/resume username - resume one customer\n/paused - list paused customers\n\n/orders - pending and confirmed orders\n/stock M01 42 3 - set stock of model M01, size 42, to 3 pairs\n/ship ORDER_ID TTN - mark order shipped and send the tracking number to the buyer",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
