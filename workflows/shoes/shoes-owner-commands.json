    {
      "parameters": {
        "jsCode": "const rows = $('Get paused rows').all().map(i => i.json).filter(r => r.ig_user_id && r.paused_until && new Date(r.paused_until) > new Date());\nconst names = {};\nfor (const c of $input.all()) { if (c.json.ig_user_id) names[c.json.ig_user_id] = c.json.username; }\nlet text = 'No customers are paused.';\nif (rows.length) {\n  text = 'Paused customers:\\n' + rows.map(r => '- ' + (names[r.ig_user_id] || r.ig_user_id) + ' until ' + new Date(r.paused_until).toLocaleString('en-GB', { timeZone: 'Europe/Kiev' }) + ' (' + (r.reason || '') + ')').join('\\n');\n}\nreturn [{ json: { text, chat_id: $('Parse owner command').first().json.chat_id } }];"
      },
