      "id": "6a2cad88-6a2a-43e0-9fea-e297a89e29c3",
      "name": "Pair still in stock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1296,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "const order = $('Get order').first().json;\nconst row = $('Get catalog row').first().json;\nconst col = 'size_' + String(order.size).replace(/\\D/g, '');\nconst out = { updated_at: new Date().toISOString() };\nfor (let s = 36; s <= 46; s++) {\n  const k = 'size_' + s;\n  const v = row[k];\n  out[k] = (v === null || v === undefined) ? null : Number(v) - (k === col ? 1 : 0);\n}\nreturn [{ json: out }];"
      },
